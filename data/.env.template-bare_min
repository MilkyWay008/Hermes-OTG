# Hermes Agent Environment Configuration
# Hermes OTG — API keys and secrets
# Copy this to .env and fill in your keys
# At minimum, set one provider's API key for the agent to work.

# OpenRouter (recommended — access to many models)
# OPENROUTER_API_KEY=your-openrouter-key-here

# DeepSeek (alternative)
# DEEPSEEK_API_KEY=your-deepseek-key-here

# api key from your Nvidia build account found at build.nvidia.com
# NVIDIA_API_KEY=your-nvidia-key-here

# Anthropic
# ANTHROPIC_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Groq
# GROQ_API_KEY=


# Hermes-OTG API server key (required for API server mode)
# API_SERVER_KEY=desk-your-otg-api-key-here-create-your-own

### Gateway is OFF by default in OTG mode (HERMES_OTG=1).
### Start it explicitly: Hermes-OTG.exe gateway run
#
# These are pre-configured for OTG mode:
# API_SERVER_PORT=7642   (set by hermes-gateway-start.cmd)
# HERMES_OTG=1            (set by hermes-gateway-start.cmd)


# Tavily search API key
# TAVILY_API_KEY=

# OpenCode ACP integration — points Hermes' ACP spawner at OpenCode
# HERMES_COPILOT_ACP_ARGS=acp
# HERMES_COPILOT_ACP_COMMAND=path-to-opencode-ai/bin/opencode.exe

# let the agent read its session_id from system prompt
HERMES_TUI_PASS_SESSION_ID=1




