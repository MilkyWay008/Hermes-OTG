# ── Hermes OTG — Full Configuration ──────────────────────────────────────
# HERMES_HOME points to <package_root>/data/
# All relative paths are relative to that data/ directory.
# This file defines the default runtime behaviour for the OTG package.
# Edit freely — it lives inside the OTG package and won't be overwritten.
#
# Port 7642 is used instead of the installed Hermes' 8642 to avoid conflicts.
# Gateway platforms are OFF by default (OTG mode). Use hermes-gateway-start.cmd
# to start the API server for programmatic access.
#
# ── Model ────────────────────────────────────────────────────────────────

model:
  provider: openrouter
  default: deepseek/deepseek-v4-flash

fallback_providers:
  - model: qwen/qwen3.5-flash-02-23
    provider: openrouter
  - model: deepseek-v4-flash
    provider: deepseek
  - model: deepseek-ai/deepseek-v4-flash
    provider: nvidia


# ── Agent ────────────────────────────────────────────────────────────────

agent:
  max_turns: 100
  gateway_timeout: 1800
  restart_drain_timeout: 0
  api_max_retries: 3
  service_tier: ''
  tool_use_enforcement: auto
  intent_ack_continuation: auto
  task_completion_guidance: true
  parallel_tool_call_guidance: true
  environment_probe: true
  environment_hint: ''
  coding_context: auto
  verify_on_stop: auto
  gateway_timeout_warning: 900
  clarify_timeout: 3600
  gateway_notify_interval: 180
  gateway_auto_continue_freshness: 3600
  image_input_mode: auto
  disabled_toolsets: []

# ── Terminal ─────────────────────────────────────────────────────────────

terminal:
  backend: local
  modal_mode: auto
  cwd: '../workspace/'
  timeout: 180
  env_passthrough: []
  home_mode: auto
  shell_init_files: []
  auto_source_bashrc: true
  persistent_shell: true

# ── Web / Browser ────────────────────────────────────────────────────────

web:
  backend: ddgs
  search_backend: ddgs
  extract_backend: native    # web-native's provider name — REQUIRED, else extract falls back to ddgs (search-only)

plugins:
  enabled:
    - web-native     # keyless trafilatura extraction
    - web-ddgs       # keyless DuckDuckGo search

browser:
  inactivity_timeout: 120
  command_timeout: 30
  record_sessions: false
  allow_private_urls: false
  engine: auto
  auto_local_for_private_urls: true
  cdp_url: ''
  dialog_policy: must_respond
  dialog_timeout_s: 300
  camofox:
    managed_persistence: false
    user_id: ''
    session_key: ''
    adopt_existing_tab: false
    rewrite_loopback_urls: false
    loopback_host_alias: host.docker.internal

# ── Checkpoints ──────────────────────────────────────────────────────────

checkpoints:
  enabled: false
  max_snapshots: 20
  max_total_size_mb: 500
  max_file_size_mb: 10
  auto_prune: true
  retention_days: 7
  min_interval_hours: 24

# ── Tool Output ──────────────────────────────────────────────────────────

tool_output:
  max_bytes: 50000
  max_lines: 2000
  max_line_length: 2000

# ── Compression ──────────────────────────────────────────────────────────

compression:
  enabled: true
  threshold: 0.75
  target_ratio: 0.20
  protect_last_n: 20
  hygiene_hard_message_limit: 5000
  protect_first_n: 3
  abort_on_summary_failure: false
  codex_gpt55_autoraise: true
  in_place: true

# ── OpenRouter Settings ─────────────────────────────────────────────────

openrouter:
  response_cache: true
  response_cache_ttl: 300
  min_coding_score: 0.65

# ── Auxiliary Models ─────────────────────────────────────────────────────

auxiliary:
  vision:
    provider: auto
    model: ''
    timeout: 120
    download_timeout: 30
  web_extract:
    provider: auto
    model: ''
    timeout: 360
  compression:
    provider: auto
    model: ''
    timeout: 120
  skills_hub:
    provider: auto
    model: ''
    timeout: 30
  approval:
    provider: auto
    model: ''
    timeout: 30
  mcp:
    provider: auto
    model: ''
    timeout: 30
  title_generation:
    provider: auto
    model: ''
    timeout: 30
  tts_audio_tags:
    provider: auto
    model: ''
    timeout: 30
  triage_specifier:
    provider: auto
    model: ''
    timeout: 120
  kanban_decomposer:
    provider: auto
    model: ''
    timeout: 180
  profile_describer:
    provider: auto
    model: ''
    timeout: 60
  curator:
    provider: auto
    model: ''
    timeout: 600
  monitor:
    provider: auto
    model: ''
    timeout: 60
  background_review:
    provider: auto
    model: ''
    timeout: 120

# ── Display ──────────────────────────────────────────────────────────────

display:
  compact: false
  personality: ''
  interface: cli
  tui_auto_resume_recent: false
  tui_agents_nudge: true
  bell_on_complete: false
  show_reasoning: true
  memory_notifications: 'on'
  streaming: false
  timestamps: false
  final_response_markdown: strip
  persistent_output: true
  persistent_output_max_lines: 200
  inline_diffs: true
  file_mutation_verifier: true
  credits_notices: true
  turn_completion_explainer: true
  show_cost: false
  skin: default
  language: en
  tui_status_indicator: kaomoji
  interim_assistant_messages: true
  tool_preview_length: 0
  friendly_tool_labels: true
  pet:
    enabled: false
    slug: ''

# ── Platforms ────────────────────────────────────────────────────────────
# In OTG mode, only the API server is enabled.
# Gateway messaging platforms (Telegram, Discord, Slack) are OFF.
# Use hermes-gateway-start.cmd for API server access.

platforms:
  api_server:
    enabled: true
    extra:
      host: 127.0.0.1
      port: 7642

platform_toolsets:
  cli:
    - browser
    - clarify
    - code_execution
    - computer_use
    - context_engine
    - cronjob
    - delegation
    - file
    - homeassistant
    - image_gen
    - kanban
    - memory
    - session_search
    - skills
    - spotify
    - terminal
    - todo
    - tts
    - video
    - video_gen
    - vision
    - web
    - x_search

# ── Gateway ──────────────────────────────────────────────────────────────

gateway:
  enabled: false
  port: 7642
  message_timestamps:
    enabled: true
  strict: false
  trust_recent_files: true
  trust_recent_files_seconds: 600

# ── Memory ───────────────────────────────────────────────────────────────

memory:
  memory_enabled: true
  user_profile_enabled: true
  write_approval: false
  memory_char_limit: 50000
  user_char_limit: 50000
  provider: ''

# ── Delegation (Subagent) ───────────────────────────────────────────────

delegation:
  model: ''
  provider: ''
  base_url: ''
  api_key: ''
  api_mode: ''
  inherit_mcp_toolsets: true
  max_iterations: 50
  child_timeout_seconds: 0
  reasoning_effort: ''
  max_concurrent_children: 5
  max_spawn_depth: 2
  orchestrator_enabled: true
  subagent_auto_approve: false
  max_async_children: 15

# ── Security ─────────────────────────────────────────────────────────────

security:
  allow_private_urls: false
  redact_secrets: true
  tirith_enabled: true
  tirith_path: tirith
  tirith_timeout: 5
  tirith_fail_open: true
  website_blocklist:
    enabled: false
    domains: []
    shared_files: []
  acked_advisories: []
  allow_lazy_installs: true

# ── Privacy ──────────────────────────────────────────────────────────────

privacy:
  redact_pii: false

# ── Logging ──────────────────────────────────────────────────────────────

logging:
  level: INFO
  max_size_mb: 5
  backup_count: 3

# ── Curator ─────────────────────────────────────────────────────────────

curator:
  enabled: true
  interval_hours: 168
  min_idle_hours: 2
  stale_after_days: 30
  archive_after_days: 90
  consolidate: false
  prune_builtins: true
  backup:
    enabled: true
    keep: 5

# ── Sessions ─────────────────────────────────────────────────────────────

sessions:
  auto_prune: false
  retention_days: 90
  vacuum_after_prune: true
  min_interval_hours: 24

# ── Steamline ──────────────────────────────────────────────────────────

streaming: true

# ── Network ──────────────────────────────────────────────────────────────

network:
  force_ipv4: false

# ── Code Execution ──────────────────────────────────────────────────────

code_execution:
  mode: project
  max_tool_calls: 50
  timeout: 360

# ── Tools ───────────────────────────────────────────────────────────────

tools:
  tool_search:
    enabled: auto
    threshold_pct: 10
    search_default_limit: 5
    max_search_limit: 20


# ── Model Catalog ────────────────────────────────────────────────────────

model_catalog:
  enabled: true
  url: https://hermes-agent.nousresearch.com/docs/api/model-catalog.json
  ttl_hours: 1


# ── Kanban ───────────────────────────────────────────────────────────────

kanban:
  dispatch_in_gateway: false
  dispatch_interval_seconds: 60
  failure_limit: 2
  auto_decompose: true
  auto_decompose_per_tick: 3
  dispatch_stale_timeout_seconds: 14400

# ── Skills ──────────────────────────────────────────────────────────────

skills:
  external_dirs: []
  template_vars: true
  inline_shell: false
  inline_shell_timeout: 10
  write_approval: false
  creation_nudge_interval: 15
  disabled:
    - ' '
    - '"'
    - ','
    - '-'
    - '['
    - ']'
    - a
    - c
    - d
    - e
    - k
    - l
    - m
    - n
    - o
    - p
    - pokemon-player
    - r
    - u
    - y
    - yuanbao

# ── MCP Server Examples ─────────────────────────────────────────────────
# Install each server in <package_root>/mcp_servers/<name>/ with its own venv.
# Hermes launches them as subprocesses; uncomment and adjust paths as needed.
#
mcp_servers:
  windows-mcp:
    command: ../mcp_servers/windows-mcp/.venv/Scripts/python.exe
    args: ["-m", "windows_mcp", "serve"]
    enabled: true
