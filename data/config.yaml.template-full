# ── TTS / STT ────────────────────────────────────────────────────────────
# Piper (OFFLINE, bundled): the voice model ships in <otg-root>\dependencies\tts-models\
# (staged from full-otg\otg-tts-models by assemble-otg-package.sh). The
# ${HERMES_HOME} ref expands to <otg-root>\data\ at config load, so
# voices_dir resolves to <otg-root>\dependencies\tts-models\ on any drive/folder.
# Requires piper-tts in the internal venv (data\hermes-agent\venv).
# Switch provider to "edge" for internet neural voices (edge-tts bundled).
tts:
  provider: piper
  piper:
    voice: en_US-lessac-medium
    voices_dir: ${HERMES_HOME}../dependencies/tts-models
