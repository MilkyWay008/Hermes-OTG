#   enabled: true
#   provider: local
#   language: en
# voice:
#   record_key: ctrl+b
#   max_recording_seconds: 120

# ── Onboarding ───────────────────────────────────────────────────────────

onboarding:
  profile_build: ask

# ── Config version (internal) ────────────────────────────────────────────

_config_version: 33
